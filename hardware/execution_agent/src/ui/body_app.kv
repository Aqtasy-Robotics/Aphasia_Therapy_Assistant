#:import dp kivy.metrics.dp
<RoundedBlueButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: "26sp"
    canvas.before:
        Color:
            rgba: (0.15, 0.38, 0.93, 1) if self.state == "normal" else (0.12, 0.33, 0.82, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [24, 24, 24, 24]

<CategoryCard@Button>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: "30sp"
    halign: "center"
    valign: "middle"
    text_size: self.width - dp(12), self.height - dp(12)
    canvas.before:
        Color:
            rgba: (0.15, 0.38, 0.93, 1) if self.state == "normal" else (0.12, 0.33, 0.82, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18, 18, 18, 18]

<SoftPanel@BoxLayout>:
    orientation: "vertical"
    padding: dp(20), dp(14)
    canvas.before:
        Color:
            rgba: 0.94, 0.94, 0.94, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20, 20, 20, 20]

<BackButton@Button>:
    size_hint: None, None
    size: dp(180), dp(56)
    background_normal: ""
    background_down: ""
    background_color: 1, 1, 1, 0
    color: 0.08, 0.08, 0.08, 1
    bold: True
    font_size: "18sp"
    text: "<  Back to Home"
    halign: "center"
    valign: "middle"
    text_size: self.size
    padding: 0, 0
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [25, 25, 25, 25]
        Color:
            rgba: 0.12, 0.12, 0.12, 1
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(25))
            width: 1.2

<CloseButton@Button>:
    size_hint: None, None
    size: dp(52), dp(52)
    text: "✕"
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: "22sp"
    canvas.before:
        Color:
            rgba: (0.85, 0.15, 0.15, 1) if self.state == "normal" else (0.70, 0.10, 0.10, 1)
        Ellipse:
            pos: self.pos
            size: self.size

<HeaderBar@BoxLayout>:
    size_hint_y: None
    height: dp(64)
    padding: dp(16), dp(8)
    canvas.before:
        Color:
            rgba: 0.96, 0.96, 0.96, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.86, 0.86, 0.86, 1
        Line:
            points: self.x, self.y, self.right, self.y
            width: 1

<BaseUiScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        HeaderBar:
            BackButton:
                on_release: app.on_nav_home()
            Widget:
            CloseButton:
                on_release: app.on_close_app()

        Widget:

        GridLayout:
            cols: 2
            size_hint: None, None
            size: min(root.width * 0.95, dp(760)), dp(220)
            pos_hint: {"center_x": 0.5}
            spacing: dp(16)

            RoundedBlueButton:
                text: "Start Therapy\\nSession"
                on_release: app.on_start_session()

            RoundedBlueButton:
                text: "Self Practice"
                on_release: app.on_self_practice()

        Widget:

        BoxLayout:
            size_hint_y: None
            height: dp(70)
            padding: dp(12), dp(8)
            spacing: dp(16)
            Widget:
            Button:
                size_hint: None, None
                size: dp(58), dp(58)
                text: "S"
                background_normal: ""
                background_down: ""
                color: 1, 1, 1, 1
                bold: True
                font_size: "26sp"
                on_release: app.on_open_settings()
                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.08, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size

<CategorySelectionScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"

        HeaderBar:
            BackButton:
                on_release: app.on_nav_home()
            Widget:
            CloseButton:
                on_release: app.on_close_app()

        Widget:
            size_hint_y: 0.12

        Label:
            text: "Choose Category"
            size_hint_y: None
            height: dp(44)
            color: 0.06, 0.06, 0.06, 1
            bold: True
            font_size: "34sp"

        Label:
            text: "Select words to practice"
            size_hint_y: None
            height: dp(28)
            color: 0.45, 0.45, 0.45, 1
            font_size: "18sp"

        GridLayout:
            cols: 2
            size_hint: None, None
            size: min(root.width * 0.80, dp(640)), dp(260)
            pos_hint: {"center_x": 0.5}
            spacing: dp(18)

            CategoryCard:
                text: "Food"
                on_release: app.on_select_category("food")
            CategoryCard:
                text: "Objects"
                on_release: app.on_select_category("objects")
            CategoryCard:
                text: "People"
                on_release: app.on_select_category("people")
            CategoryCard:
                text: "All"
                on_release: app.on_select_category("all")

        Widget:
            size_hint_y: 0.1

<PracticeWordScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"

        HeaderBar:
            BackButton:
                on_release: app.on_nav_home()
            Widget:
            CloseButton:
                on_release: app.on_close_app()

        BoxLayout:
            orientation: "vertical"
            padding: dp(18), dp(12)

            SoftPanel:
                spacing: dp(8)

                BoxLayout:
                    size_hint_y: None
                    height: dp(28)
                    Label:
                        text: root.progress_text
                        color: 0.42, 0.42, 0.42, 1
                        font_size: "16sp"
                        halign: "left"
                        text_size: self.size
                    Label:
                        text: root.category_text
                        color: 0.42, 0.42, 0.42, 1
                        font_size: "16sp"
                        halign: "right"
                        text_size: self.size

                ProgressBar:
                    max: 1
                    value: root.progress_value
                    size_hint_y: None
                    height: dp(8)

                BoxLayout:
                    size_hint_y: None
                    height: dp(160)
                    padding: dp(12), dp(0)

                    Button:
                        size_hint: None, None
                        size: dp(56), dp(56)
                        pos_hint: {"center_y": 0.5}
                        text: "‹"
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        color: 1, 1, 1, 1
                        bold: True
                        font_size: "38sp"
                        on_release: app.on_prev_word()
                        canvas.before:
                            Color:
                                rgba: (0.80, 0.82, 0.86, 1) if self.state == "normal" else (0.72, 0.75, 0.80, 1)
                            Ellipse:
                                pos: self.pos
                                size: self.size

                    Label:
                        text: root.word
                        bold: True
                        color: 0.04, 0.04, 0.04, 1
                        font_size: "74sp"

                    Button:
                        size_hint: None, None
                        size: dp(56), dp(56)
                        pos_hint: {"center_y": 0.5}
                        text: "›"
                        background_normal: ""
                        background_down: ""
                        background_color: 0, 0, 0, 0
                        color: 1, 1, 1, 1
                        bold: True
                        font_size: "38sp"
                        on_release: app.on_next_word()
                        canvas.before:
                            Color:
                                rgba: (0.15, 0.38, 0.93, 1) if self.state == "normal" else (0.12, 0.33, 0.82, 1)
                            Ellipse:
                                pos: self.pos
                                size: self.size

                Button:
                    size_hint: None, None
                    size: dp(100), dp(100)
                    pos_hint: {"center_x": 0.5}
                    text: ""
                    background_normal: "src/ui/assets/mic_icon.png"
                    background_down: "src/ui/assets/mic_icon.png"
                    background_color: 1, 1, 1, 1
                    on_release: app.on_speak_tap()

                Label:
                    text: root.mic_hint
                    size_hint_y: None
                    height: dp(28)
                    color: 0.45, 0.45, 0.45, 1
                    font_size: "18sp"

<EmptyStateScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        HeaderBar:
            BackButton:
                on_release: app.on_nav_home()
            Widget:
            CloseButton:
                on_release: app.on_close_app()
        Widget:
        Label:
            text: root.empty_title
            color: 0.05, 0.05, 0.05, 1
            bold: True
            font_size: "46sp"
            size_hint_y: None
            height: dp(56)
        Label:
            text: root.empty_subtitle
            color: 0.45, 0.45, 0.45, 1
            font_size: "20sp"
            halign: "center"
            text_size: self.width * 0.8, None
            size_hint_y: None
            height: dp(52)
        Widget:

<FeedbackScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        HeaderBar:
            BackButton:
                on_release: app.on_nav_home()
            Widget:
            CloseButton:
                on_release: app.on_close_app()
        Widget:
        Label:
            text: "SUCCESS" if root.feedback_icon == "SUCCESS" else "TRY AGAIN"
            color: (0.1, 0.65, 0.22, 1) if root.feedback_icon == "SUCCESS" else (0.88, 0.2, 0.22, 1)
            bold: True
            font_size: "58sp"
            size_hint_y: None
            height: dp(68)
        Label:
            text: root.feedback_message
            color: 0.18, 0.18, 0.18, 1
            font_size: "22sp"
            size_hint_y: None
            height: dp(38)
        Widget:

<SettingsScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"

        HeaderBar:
            BackButton:
                on_release: app.on_nav_home()
            Widget:
            CloseButton:
                on_release: app.on_close_app()

        BoxLayout:
            orientation: "vertical"
            padding: dp(24), dp(12)
            spacing: dp(10)

            Label:
                text: "Settings"
                color: 0.07, 0.07, 0.07, 1
                bold: True
                font_size: "36sp"
                size_hint_y: None
                height: dp(44)
                halign: "left"
                text_size: self.size

            SoftPanel:
                size_hint_y: None
                height: dp(95)
                Label:
                    text: "Volume: " + root.volume_text
                    color: 0.16, 0.16, 0.16, 1
                    font_size: "20sp"
                    halign: "left"
                    text_size: self.size

            SoftPanel:
                size_hint_y: None
                height: dp(95)
                Label:
                    text: "Server URL: " + root.server_url
                    color: 0.16, 0.16, 0.16, 1
                    font_size: "17sp"
                    halign: "left"
                    text_size: self.size

            SoftPanel:
                size_hint_y: None
                height: dp(95)
                Label:
                    text: "Device ID: " + root.device_id
                    color: 0.16, 0.16, 0.16, 1
                    font_size: "17sp"
                    halign: "left"
                    text_size: self.size

            Widget:
