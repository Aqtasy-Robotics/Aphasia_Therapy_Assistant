#:import dp kivy.metrics.dp

<SpeechTherapyRoot>:
    canvas.before:
        Color:
            rgba: 248/255, 250/255, 252/255, 1  # Light background
        Rectangle:
            pos: self.pos
            size: self.size

    orientation: "vertical"
    padding: 0
    spacing: 0

    # This will be populated dynamically based on current screen
