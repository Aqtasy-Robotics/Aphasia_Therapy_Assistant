# Copy to .env and fill in. Never commit the real .env file.
#
# DEVICE_ID — label for this robot in URLs (/commands/{id}, /audio/{id}, /ui-events/{id}).
# It does NOT have to be a Supabase user id. For personalized bridge "speak" commands, set
# BRIDGE_PATIENT_PROFILE_ID on the FastAPI server (see backend/.env.example).
SERVER_URL=http://127.0.0.1:8000
DEVICE_ID=robot-pi-001
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
PIPER_MODEL_CONFIG=models/en_US-lessac-medium.onnx.json
LOG_LEVEL=INFO

# LangGraph / Kivy GUI (optional here if already in repo root .env)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# GROQ_API_KEY=
