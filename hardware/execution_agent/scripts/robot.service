[Unit]
Description=Aphasia Therapy Robot Execution Agent
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/execution_agent
ExecStart=/home/pi/execution_agent/.venv/bin/python /home/pi/execution_agent/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables can be set here if needed
# Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
