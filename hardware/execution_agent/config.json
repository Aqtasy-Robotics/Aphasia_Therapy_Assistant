{
    "polling": {
        "enabled": false,
        "interval_seconds": 2.0,
        "timeout_seconds": 5.0,
        "max_retries": 3
    },
    "audio": {
        "sample_rate": 44100,
        "channels": 1,
        "volume": 0.8,
        "input_device": null,
        "output_device": null
    },
    "gpio": {
        "servo_pan_pin": 17,
        "servo_min_pulse_width": 0.0005,
        "servo_max_pulse_width": 0.0025
    },
    "oled": {
        "interface": "spi",
        "oled_driver": "sh1107",
        "i2c_port": 1,
        "i2c_address": "0x3C",
        "spi_port": 0,
        "spi_device": 0,
        "spi_gpio_dc": 24,
        "spi_gpio_rst": 25,
        "spi_bus_speed_hz": 8000000,
        "width": 128,
        "height": 128,
        "rotate": 1,
        "eye_layout": "horizontal",
        "eyes_bias_x": -0.28,
        "standalone_math_eyes": true,
        "default_expression": "neutral",
        "frame_delay_seconds": 0.05
    },
    "display": {
        "width": 800,
        "height": 480,
        "fullscreen": true
    },

    
    "laptop_server": {
        "url": "http://192.168.8.103:8001",
        "_comment": "LangGraph session server (laptop_server.py). Keep on port 8000. Robot Bridge (backend/main.py) must run on port 8001 — see SERVER_URL in .env"
    }
    
}
