# Copy to .env for local FastAPI bridge. Never commit secrets.

GROQ_API=
GROQ_API_KEY=
SAMPLE_RATE=16000
RECORD_SECONDS=8
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: when the robot uses a non-UUID DEVICE_ID (e.g. robot-pi-001), set this to the
# patient's profiles.id UUID so GET /commands/{device_id} can personalize the greeting.
# BRIDGE_PATIENT_PROFILE_ID=
